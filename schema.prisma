// Prisma schema with a PostgreSQL datasource. Set DATABASE_URL in your .env
datasource db {
	provider = "postgresql"
	url      = env("DATABASE_URL")
}

generator client {
	provider = "prisma-client-js"
}

// Minimal example models — expand to match your original schema
model User {
	id        String   @id @default(uuid())
	email     String   @unique
	passhash  String
	name      String?
	primaryCraft String?
	secondaryCraft String?
	profile   Profile?
	createdAt DateTime @default(now())
}

model Profile {
	id      String  @id @default(uuid())
	userId  String  @unique
	summary String?
	strengths String?
	improvements String?
	user    User    @relation(fields: [userId], references: [id])
}

model RefreshToken {
	token     String @id
	userId    String
	expiresAt DateTime
}

model Assessment {
	id     String @id @default(uuid())
	userId String
	type   String
	prompt String
	response String
	score  Int?
}

model SkillMap {
	id     String @id @default(uuid())
	userId String
	domain String
	level  Int
}

